From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LinkBoi00 <linkdevel@protonmail.com>
Date: Sun, 12 Feb 2023 15:45:44 +0200
Subject: [PATCH] drivers: usb: typec: Mark unused variables as __maybe_unused

Original patch:
https://github.com/LineageOS/android_kernel_xiaomi_mt6785/commit/38584af791e95b4c340d4fe4cf15ae429575bd38

Signed-off-by: LinkBoi00 <linkdevel@protonmail.com>
Signed-off-by: Sevenrock <sevenrock@hotmail.de>
---
 drivers/usb/typec/mmi_tcpc/pd_dpm_alt_mode_dp.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/usb/typec/mmi_tcpc/pd_dpm_alt_mode_dp.c b/drivers/usb/typec/mmi_tcpc/pd_dpm_alt_mode_dp.c
index b6b73c388baf..90e1afa404c5 100644
--- a/drivers/usb/typec/mmi_tcpc/pd_dpm_alt_mode_dp.c
+++ b/drivers/usb/typec/mmi_tcpc/pd_dpm_alt_mode_dp.c
@@ -349,7 +349,7 @@ static inline uint8_t dp_dfp_u_select_mode(struct pd_port *pd_port,
 	struct svdm_mode *remote, *local;
 	int i, j;
 	int match_score, best_match_score = 0;
-	int local_index = -1, remote_index = -1;
+	int __maybe_unused local_index = -1, remote_index = -1;
 	struct tcpc_device __maybe_unused *tcpc = pd_port->tcpc;
 
 	local = &svid_data->local_mode;
